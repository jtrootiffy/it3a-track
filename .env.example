# ---------------------------------------------------------------------------
# IT3A - TRACK  |  environment variables
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored and must never be committed.
# ---------------------------------------------------------------------------

# --- Supabase project -------------------------------------------------------
# Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# SERVER ONLY. Bypasses Row Level Security.
# Used only by lib/supabase/service.ts (username -> email login lookup) and by
# the scripts in /scripts. Never expose this with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# --- Migrations -------------------------------------------------------------
# Dashboard -> Project Settings -> Database -> Connection string -> URI
# Used only by `npm run migrate`.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DATABASE-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Administrator provisioning --------------------------------------------
# Read only by `npm run setup:admins`. Passwords are never printed or shipped to
# the browser; they are hashed by Supabase Auth.
#
# The two accounts are fixed by the brief:
#   dexter.gravoso  -> Dexter Gravoso
#   troy.lagahit    -> Troy Lagahit
#
# The email is the private Supabase Auth identity. It is never shown on the
# public page. Use a real inbox you control.
IT3A_ADMIN_1_USERNAME=dexter.gravoso
IT3A_ADMIN_1_EMAIL=dexter.gravoso@example.com
IT3A_ADMIN_1_FULL_NAME=Dexter Gravoso
IT3A_ADMIN_1_PASSWORD=replace-with-a-strong-password

IT3A_ADMIN_2_USERNAME=troy.lagahit
IT3A_ADMIN_2_EMAIL=troy.lagahit@example.com
IT3A_ADMIN_2_FULL_NAME=Troy Lagahit
IT3A_ADMIN_2_PASSWORD=replace-with-a-strong-password
